<?xml version="1.0" encoding="utf-8"?>
<!-- versionCode and versionName come from the Python package (tools/build_agent.py). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.courtbooker.agent">

    <application android:label="Court Booker agent" android:hasCode="true">
        <!-- Opened once after install: Android never binds a package that was never started. -->
        <activity android:name=".MainActivity" android:exported="true" />
        <service
            android:name=".AgentService"
            android:exported="false"
            android:label="Court Booker agent"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/agent" />
        </service>
    </application>
</manifest>
